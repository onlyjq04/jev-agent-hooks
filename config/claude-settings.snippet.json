{
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/jev-skill-suggest.mjs",
            "timeout": 10,
            "statusMessage": "Jev suggests a skill"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/subagent-model-gate.mjs",
            "timeout": 10,
            "statusMessage": "Checking subagent model assignment"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/jev-agent-gate.mjs",
            "timeout": 10,
            "statusMessage": "Jev reviews the subagent dispatch"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/subagent-return-gate.mjs",
            "timeout": 10,
            "statusMessage": "Checking the subagent's deliverable"
          }
        ]
      }
    ]
  }
}
